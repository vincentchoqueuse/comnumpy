# comnumpy matplotlib style sheet (decision D27b).
# Shipped with the package, NEVER applied at import time. Activate it
# explicitly:
#     plt.style.use(comnumpy.style.PATH)      # global
#     with comnumpy.style.context(): ...      # scoped
#
# Colors: Okabe-Ito palette (colorblind-safe); information is never
# carried by color alone (decision D27c) -- pair with markers/hatches.

axes.prop_cycle : cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000'])

figure.figsize  : 6.4, 4.0
figure.dpi      : 110
# 150, not the 300 of a printed figure: these figures are read on a web
# page, they are committed, and 300 dpi tripled every PNG in the
# repository for pixels no screen shows.
savefig.dpi     : 150
savefig.bbox    : tight

axes.grid       : True
grid.alpha      : 0.35
grid.linewidth  : 0.6

axes.spines.top    : False
axes.spines.right  : False

lines.linewidth : 1.6
lines.markersize : 5.5

font.size       : 10
axes.titlesize  : 11
axes.labelsize  : 10
legend.fontsize : 9
legend.frameon  : False

mathtext.default : regular
